# Local SUPERHOT game install, used only for local build/testing (SuperhotGameDir points
# here) -- this is a full copy of the actual commercial game (SH.exe, SH_Data/ assets,
# etc.), never something to commit or publish. Critical: must stay ignored even though it
# sits at the project root alongside apworld/ and mod/.
/SUPERHOT/

# .NET build output (mod/SuperhotArchipelago/)
bin/
obj/
*.user

# Python bytecode cache (apworld/superhot/)
__pycache__/
*.pyc

# Editor/OS cruft
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Internal working notes -- kept locally for our own reference, deliberately not part of
# the public repo. TESTING.md's user-facing content now lives inline in README.md instead.
/TESTING.md
/ARCHITECTURE.md
/NOTES.md
/MOD_GUIDE.md

# Packaged mod release zips -- these are Nexus upload artifacts (Mods/ + UserLibs/,
# built from mod/SuperhotArchipelago's own build output), not source, and don't belong
# in git history. The apworld's built copy is still tracked at dist/superhot.apworld
# since that one *is* meant to live in a GitHub release built from this repo.
#
# Real bug found while auditing repo hygiene: this pattern was anchored to the repo
# root (leading slash), but the zip is actually built into dist/ -- so it was never
# actually being ignored at all, and kept showing up as untracked in `git status`.
# Un-anchored so it matches at any depth, same as the other patterns in this file.
SuperhotArchipelago_v*.zip
