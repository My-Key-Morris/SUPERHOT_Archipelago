<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      CONFIRMED (checked the real install): SH_Data/Managed/Assembly-CSharp.dll exists,
      so this is a Mono build, not IL2CPP. MelonLoader's net472 runtime is the right one
      (there's also a net6 folder in MelonLoader for IL2CPP games; not what we want
      here). app.info confirms MelonGame identifiers too: "SUPERHOT_Team" / "SUPERHOT",
      already set correctly in Core/Mod.cs.
    -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SuperhotArchipelago</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    SuperhotGameDir must point at a real SUPERHOT install (the folder containing SH_Data/
    and MelonLoader/). Deliberately not hardcoded here: every dev's install lives
    somewhere different, and an earlier version of this file hardcoded one specific
    machine's path, which both leaked a local username into source control and silently
    broke the build for anyone else. Set it one of three ways:
      1. A build-time property: dotnet build -p:SuperhotGameDir="C:\path\to\SUPERHOT"
      2. A SuperhotGameDir (or SUPERHOT_GAME_DIR) environment variable; MSBuild picks up
         environment variables as properties automatically.
      3. A local, gitignored SuperhotArchipelago.csproj.user file (MSBuild loads this
         automatically if present) setting SuperhotGameDir inside a PropertyGroup, the
         usual place per-developer local settings like this live.
    See TESTING.md/ARCHITECTURE.md for the full build command.
  -->
  <PropertyGroup>
    <SuperhotGameDir Condition="'$(SuperhotGameDir)' == ''">$(SUPERHOT_GAME_DIR)</SuperhotGameDir>
  </PropertyGroup>

  <Target Name="RequireSuperhotGameDir" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error
      Condition="'$(SuperhotGameDir)' == ''"
      Text="SuperhotGameDir is not set -- see this file's own comment above for three ways to set it (build-time -p:, an environment variable, or a local .csproj.user file)." />
  </Target>

  <ItemGroup>
    <!-- Official Archipelago C# client; opens its own WebSocket, no external process needed. -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(SuperhotGameDir)\MelonLoader\net472\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SuperhotGameDir)\MelonLoader\net472\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SuperhotGameDir)\SH_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SuperhotGameDir)\SH_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SuperhotGameDir)\SH_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SuperhotGameDir)\SH_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Input/KeyCode (Core/ArchipelagoConnectApp.cs's free-text field entry, using the
         same Input.inputString/GetKeyDown pattern the game's own native dev console,
         AppSHConsole, uses) live here, not UnityEngine.CoreModule; confirmed by listing
         this module's real types via ilspycmd against the actual shipped DLL. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SuperhotGameDir)\SH_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Used by Core/LevelCatalog.cs to parse data/levels.json. MelonLoader already
         ships this DLL (mods load in the same process/AppDomain as MelonLoader itself),
         so we reference its copy rather than pulling in a second one via NuGet. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SuperhotGameDir)\MelonLoader\net472\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the level catalog data next to the built DLL so LevelCatalog.Load() can
         find it at runtime (see Core/LevelCatalog.cs). -->
    <None Include="data\levels.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
